# Copy this file to `.env` and fill it in.

# The app server (server/app.py): signaling, camera pairing and
# motion history/clips.
SERVER_IP=http://192.168.1.100:5050

# Your Supabase project, used for Viewer Mode sign-in (Project Settings →
# API Keys). The publishable key (or a legacy anon key) is meant to ship in
# client apps. Never put a secret/service-role key or JWT secret here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
