# Copy to `.env` (read on startup by app.py) and fill in from your
# Supabase project: Project Settings → API / Data API.

# The server reaches the project's database through this URL, and verifies
# sign-ins against it (projects on asymmetric JWT signing keys fetch signing
# keys from its JWKS endpoint).
SUPABASE_URL=https://your-project-ref.supabase.co
# The *secret* key (Project Settings → API Keys → Secret keys, sb_secret_…),
# not the publishable key the mobile app uses: tables have RLS on with no
# policies, so only the secret key can read them. Never ship it in the app.
SUPABASE_KEY=

# Only for projects still on the legacy shared JWT secret (HS256). Leave
# unset otherwise. This is a secret: never put it in the mobile app.
SUPABASE_JWT_SECRET=

# For local testing: keep data in this SQLite file (relative to server/)
# instead of the Supabase project. SUPABASE_KEY is then not needed, and
# sign-in still goes through Supabase Auth via SUPABASE_URL.
# SQLITE_PATH=data/local.db
SQLITE_PATH=

# The LiveKit server that carries live video (see the README). LIVEKIT_URL
# is passed to the phones, so use an address they can reach: your LAN IP
# locally, not localhost. `livekit-server --dev` uses the key/secret below.
LIVEKIT_URL=ws://192.168.1.10:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Comma-separated browser origins allowed to open the Socket.IO connection.
# The mobile app doesn't need any.
CORS_ORIGINS=

# Motion events and their clips older than this many days are deleted (0
# keeps them forever).
RETENTION_DAYS=30

# The Supabase Storage bucket clips go in (created by schema.sql).
CLIP_BUCKET=clips

# Caps clip uploads when clips are stored locally (SQLITE_PATH).
MAX_UPLOAD_MB=200
FLASK_DEBUG=0
